# Copy to .env (docker compose reads it) or export in your shell.
ENVIRONMENT=development          # set to "production" to require SECRET_KEY
SECRET_KEY=                      # generate: python -c "import secrets;print(secrets.token_hex(32))"
ADMIN_USERNAME=teacher           # first account, created on startup if missing
ADMIN_PASSWORD=                  # min 8 chars
# TOKEN_TTL_HOURS=12
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# TESSERACT_CMD=/usr/bin/tesseract
# DATA_DIR=./data
